# ============================================================
# 天树探界 · 售前 Agent 助手（P0 独立部署）
# 复制为 .env 后按需修改；生产环境请务必改掉 SECRET_KEY 与 DEMO_PASSWORD
# ============================================================

# --- 数据库（需开启 pgvector 扩展） ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/arborseek_p0

# --- 对话模型：直接复用官网既有的 OpenAI 兼容网关 ---
CHAT_BASE_URL=https://openai.arborseek.com/v1
CHAT_API_KEY=
CHAT_MODEL=deepseek-chat

# --- 向量模型与检索参数 ---
EMBED_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBED_BATCH_SIZE=8
EMBED_CPU_THREADS=2
# CPU 试运行限制重排候选，避免多个请求同时处理过大批量。
RERANK_CANDIDATES=20

RETRIEVE_TOP_K=5
# 关闭重排时用这个阈值门控；开启重排时用 RERANK_MIN_SCORE
RETRIEVE_MIN_SCORE=0.5

# ------------------------------------------------------------
# P0 配置块一：课程知识空间
# ------------------------------------------------------------
COURSE_SPACE_ID=courses
COURSE_SPACE_NAME=课程知识库
# local 历史语料迁移可先用 warn；正式上线必须改为 strict
COURSE_CONTENT_VALIDATION_MODE=strict
APPROVED_COURSE_CATALOG_PATH=data/approved_courses.json
# 默认关闭；运营审核完清单并通过预发布验收后才设置课程 ID 与灰度百分比
PILOT_COURSE_IDS=42,43,99
PILOT_PERCENT=0
VISITOR_CONSULTATION_HOURS=24
CUSTOMER_CONSULTATION_DAYS=90

# 官网 POST /miniapp/me 验证适配器，默认关闭。
# JWT 请求格式已确认；退出后的旧 JWT 本次实测仍成功，需确认撤销后再联调开启。
# ts_ 在 /miniapp/me 的支持范围、改密与封禁规则仍待确认。
# 前端凭据传递和官网实际登录回调仍需接入；不要在此填写客户令牌。
WEBSITE_IDENTITY_ENABLED=false
# 稳定环境命名空间；启用并产生客户数据后不可随意改名。
WEBSITE_IDENTITY_PROVIDER=arborseek-production
WEBSITE_IDENTITY_TIMEOUT_SECONDS=3
# 本次请求的最长验证期限，不是官网令牌有效期，也不缓存登录身份。
WEBSITE_IDENTITY_MAX_REQUEST_SECONDS=300

# ------------------------------------------------------------
# P0 配置块二：游客态（官网未登录访客）
# 游客允许空间由服务端写死为 COURSE_SPACE_ID，客户端无法指定
# ------------------------------------------------------------
VISITOR_COOKIE_NAME=arborseek_agent_visitor
VISITOR_COOKIE_MAX_AGE=2592000
GUEST_ASK_RATE_MAX=40
GUEST_ASK_RATE_WINDOW_SECONDS=60

# ------------------------------------------------------------
# P0 配置块三：未命中转人工（复用官网现有"弹售前二维码"承接点）
# 兜底售前码留空时，未匹配到课程映射会返回 configured=false，绝不编造联系方式
# ------------------------------------------------------------
HANDOFF_ENABLED=true
HANDOFF_FALLBACK_CONTACT=
HANDOFF_FALLBACK_NAME=
HANDOFF_MISS_ANSWER=这个问题我暂时没有可靠依据回答，已为你转接对应课程顾问。
# 官网课程详情；未命中且 course_id 为数字时读取 pre_sale_service_qrcode。课程正文不从这里入库。
COURSE_DETAIL_URL=https://arboradmin.saikr.com/miniapp/course/detail
COURSE_DETAIL_TIMEOUT_SECONDS=3
# 官网在售课程列表。游客未指定课程时按标题检索相关课，不把正文入库。
COURSE_LIST_URL=https://arboradmin.saikr.com/miniapp/course/list
COURSE_LIST_TIMEOUT_SECONDS=3

# --- 上传与切片 ---
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=52428800

# --- 环境与密钥 ---
# local=本机开发（会幂等写入 P0 内部账号）；prod=正式（禁默认密钥）
APP_ENV=local
SECRET_KEY=change-me-for-local-dev
DEMO_PASSWORD=demo1234

# --- 会话保留天数；启动时清理一次 ---
DATA_RETENTION_DAYS=90

# --- 下载 BGE-M3 受阻时启用 ---
# HF_ENDPOINT=https://hf-mirror.com

